---
import { docsNavigation } from '../config';
import DocNavGroup from './DocNavGroup.astro';
interface Props { currentSlug: string; }
const { currentSlug } = Astro.props;
---

<aside class="doc-sidebar" aria-label="Navigation de la documentation">
  <div class="doc-sidebar__top">
    <span><b>adenyrr@docu</b>:~$ tree</span>
    <button class="doc-search-trigger" type="button" data-search-open aria-label="Rechercher dans la documentation"><span aria-hidden="true">⌕</span> Rechercher <kbd>/</kbd></button>
  </div>
  <nav aria-label="Pages de documentation">{docsNavigation.map((group) => <DocNavGroup group={group} currentSlug={currentSlug} />)}</nav>
</aside>
