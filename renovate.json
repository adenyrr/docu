{
  "extends": [
    "config:recommended"
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/"
    ]
  },
  "automerge": false,
  "schedule": [
    "every weekend"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchPackagePrefixes": ["mkdocs-", "mkdocs"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "MkDocs plugins",
      "automerge": true
    },
    {
      "matchPackagePrefixes": ["zensical"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Zensical",
      "automerge": false
    }
  ]
}